{{#if @isVisible}}
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <!-- Background overlay -->
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>

            <!-- Modal panel -->
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                                {{this.modalTitle}}
                            </h3>
                            
                            <div class="mt-6 space-y-6">
                                <!-- Credential Name -->
                                <div>
                                    <label for="credential-name" class="block text-sm font-medium text-gray-700">
                                        Credential Name *
                                    </label>
                                    <input
                                        type="text"
                                        id="credential-name"
                                        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                        placeholder="e.g., Production API, Sandbox API"
                                        value={{this.credential.name}}
                                        {{on "input" (fn this.updateField "name")}}
                                    />
                                </div>

                                <!-- API Token -->
                                <div>
                                    <label for="api-token" class="block text-sm font-medium text-gray-700">
                                        API Token *
                                    </label>
                                    <div class="mt-1 relative">
                                        <input
                                            type="password"
                                            id="api-token"
                                            class="block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                            placeholder="Enter your Samsara API token"
                                            value={{this.credential.apiToken}}
                                            {{on "input" (fn this.updateField "apiToken")}}
                                        />
                                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                            <button
                                                type="button"
                                                class="text-blue-600 hover:text-blue-800 text-sm"
                                                {{on "click" this.testConnection}}
                                                disabled={{this.isTestingConnection}}
                                            >
                                                {{#if this.isTestingConnection}}
                                                    <FaIcon @icon="spinner" @spin={{true}} />
                                                {{else}}
                                                    Test
                                                {{/if}}
                                            </button>
                                        </div>
                                    </div>
                                    {{#if this.connectionTestResult}}
                                        <div class="mt-2 text-sm {{if this.connectionTestResult.success 'text-green-600' 'text-red-600'}}">
                                            {{this.connectionTestResult.message}}
                                        </div>
                                    {{/if}}
                                </div>

                                <!-- API Base URL -->
                                <div>
                                    <label for="api-base-url" class="block text-sm font-medium text-gray-700">
                                        API Base URL
                                    </label>
                                    <input
                                        type="url"
                                        id="api-base-url"
                                        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                        placeholder="https://api.samsara.com"
                                        value={{this.credential.apiBaseUrl}}
                                        {{on "input" (fn this.updateField "apiBaseUrl")}}
                                    />
                                    <p class="mt-1 text-sm text-gray-500">
                                        Leave blank to use the default Samsara API URL
                                    </p>
                                </div>

                                <!-- Environment Toggle -->
                                <div class="flex items-center">
                                    <input
                                        id="is-sandbox"
                                        type="checkbox"
                                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                                        checked={{this.credential.isSandbox}}
                                        {{on "change" (fn this.updateField "isSandbox")}}
                                    />
                                    <label for="is-sandbox" class="ml-2 block text-sm text-gray-900">
                                        Sandbox Environment
                                    </label>
                                </div>

                                <!-- Sync Interval -->
                                <div>
                                    <label for="sync-interval" class="block text-sm font-medium text-gray-700">
                                        Sync Interval (minutes)
                                    </label>
                                    <input
                                        type="number"
                                        id="sync-interval"
                                        min="1"
                                        max="60"
                                        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                        value={{this.credential.syncInterval}}
                                        {{on "input" (fn this.updateField "syncInterval")}}
                                    />
                                    <p class="mt-1 text-sm text-gray-500">
                                        How often to sync vehicle data (1-60 minutes)
                                    </p>
                                </div>

                                <!-- Webhook Configuration -->
                                <div class="border-t pt-6">
                                    <h4 class="text-md font-medium text-gray-900 mb-4">Webhook Configuration (Optional)</h4>
                                    
                                    <!-- Webhook URL -->
                                    <div class="mb-4">
                                        <label for="webhook-url" class="block text-sm font-medium text-gray-700">
                                            Webhook URL
                                        </label>
                                        <input
                                            type="url"
                                            id="webhook-url"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                            placeholder="https://your-domain.com/samsara/webhook"
                                            value={{this.credential.webhookUrl}}
                                            {{on "input" (fn this.updateField "webhookUrl")}}
                                        />
                                        <p class="mt-1 text-sm text-gray-500">
                                            URL where Samsara will send webhook notifications
                                        </p>
                                    </div>

                                    <!-- Webhook Secret -->
                                    <div>
                                        <label for="webhook-secret" class="block text-sm font-medium text-gray-700">
                                            Webhook Secret
                                        </label>
                                        <div class="mt-1 flex rounded-md shadow-sm">
                                            <input
                                                type="password"
                                                id="webhook-secret"
                                                class="flex-1 block w-full border-gray-300 rounded-none rounded-l-md focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                placeholder="Enter webhook secret for signature verification"
                                                value={{this.credential.webhookSecret}}
                                                {{on "input" (fn this.updateField "webhookSecret")}}
                                            />
                                            <button
                                                type="button"
                                                class="inline-flex items-center px-3 py-2 border border-l-0 border-gray-300 rounded-r-md bg-gray-50 text-gray-500 text-sm hover:bg-gray-100"
                                                {{on "click" this.generateWebhookSecret}}
                                            >
                                                Generate
                                            </button>
                                        </div>
                                        <p class="mt-1 text-sm text-gray-500">
                                            Secret used to verify webhook authenticity
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Modal Footer -->
                <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                    <button
                        type="button"
                        class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm"
                        {{on "click" this.save}}
                    >
                        {{#if this.isEditing}}Update{{else}}Create{{/if}}
                    </button>
                    <button
                        type="button"
                        class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
                        {{on "click" this.cancel}}
                    >
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
{{/if}}

